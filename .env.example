# TRISHUL Environment Configuration
# Copy this file to .env and fill in your credentials

# Copernicus Data Space Ecosystem (CDSE)
# Free registration at https://dataspace.copernicus.eu
CDSE_USERNAME=
CDSE_PASSWORD=
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# Ohsome API for pre-event OpenStreetMap snapshots
OHSOME_API_URL=https://api.ohsome.org/v1

# Copernicus DEM (GLO-30) AWS Public Bucket (anonymous access)
COP_DEM_S3_ENDPOINT=https://copernicus-dem-30m.s3.amazonaws.com

# Model checkpoint URL (Hugging Face / GitHub Release)
MODEL_CHECKPOINT_URL=https://huggingface.co/trishul-team/geosar-unet/resolve/main/geosar_unet_v1.onnx

# Optional LLM API keys for Situation Report Copilot (Grounded Claim Ledger)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Local paths & system defaults
TRISHUL_CACHE_DIR=./cache
TRISHUL_RUNS_DIR=./runs
TRISHUL_LOG_LEVEL=INFO
TRISHUL_MOCK_NETWORK_ON_MISSING_CREDS=true
